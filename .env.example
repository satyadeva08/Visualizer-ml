# VISUALISER — environment variables (placeholders only; copy values into your shell / .env.local)
# NEVER commit real secrets. There are no secrets in this project today.

# ---- Go backend (backend-go) ----
HOST=127.0.0.1                 # loopback only; the phone reaches Go through Vite's proxy
PORT=8080
ML_SERVICE_URL=http://127.0.0.1:5000
MAX_UPLOAD_MB=50
ML_TIMEOUT_SECONDS=60
ALLOWED_ORIGINS=http://localhost:5173,https://localhost:5173
ENABLE_COLLECT=0               # 1 = enable the dataset-collection endpoints (development only)

# ---- Python ML service (ml-service) ----
# PORT=5000
MODEL_PATH=                    # default: ml-service/models/classifier.pkl
DATA_DIR=                      # default: ml-service/data
# ENABLE_COLLECT=0             # must match the Go setting when collecting data
ALLOW_MOCK=0                   # 1 = allow a clearly-labelled FAKE result when no model exists
MIN_CONFIDENCE=0.5             # below this probability the answer is "unknown sign"
MIN_MOTION=0.004               # below this clip motion the answer is "no sign detected"
FFMPEG_PATH=                   # only if ffmpeg is not on PATH
MAX_VIDEO_MB=50

# ---- Frontend: see web/.env.example ----
