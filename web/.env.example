# Frontend environment variables. Copy to .env.local (never commit .env.local).

# Listen on the LAN so a phone on the same Wi-Fi can open the site.
VITE_HOST=false

# HTTPS with a self-signed certificate (needed for the camera on a phone).
VITE_HTTPS=false

# Where the Go backend runs. Vite proxies /api to it.
BACKEND_URL=http://127.0.0.1:8080

# Optional: change the dev server port
# VITE_PORT=5173

# Optional: only if the frontend is NOT served through the Vite proxy
# VITE_API_BASE_URL=
